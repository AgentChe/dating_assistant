# Скопируйте в .env (он в .gitignore) и подставьте ключ. В git и в приложение ключ не попадает.
GEMINI_API_KEY=

# Необязательно — значения по умолчанию в скобках.
# GEMINI_MODEL=googleai/gemini-3.8-flash   (модель для всех трёх запросов)
# PORT=8080
# HOST=127.0.0.1                           (слушать только локальный адрес — за nginx на сервере)
